# Server Configuration
# NOTE: port 5000 is often taken by macOS AirPlay Receiver, which you cannot
# always disable. 5001 is the safe default for local development — if you change
# it here, change NEXT_PUBLIC_API_URL in frontend/.env.local to match.
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/taskflow

# JWT Configuration
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

